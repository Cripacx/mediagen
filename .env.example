# Copy to .env for per-project settings. Never commit the real file.
# Spec §3.2 — the process environment overrides this file, which overrides the
# per-machine config written by `mediagen init`.

# Which provider a request uses when it does not name one.
MEDIAGEN_PROVIDER=gemini

# One key per provider. Only the provider you actually use needs one.
GEMINI_API_KEY=
OPENAI_API_KEY=
KIE_API_KEY=

# Optional: pin a model per provider.
# GEMINI_MODEL=
# OPENAI_MODEL=
# KIE_MODEL=

# Where generated media is written.
MEDIAGEN_OUTPUT_DIR=./output

# fast | balanced | quality
MEDIAGEN_QUALITY=fast

# Prompt enhancement is on unless this is set to a false-ish value.
MEDIAGEN_ENHANCE=true
